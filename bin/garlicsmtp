#!/usr/bin/env python3

from garlicsmtp.version import print_version
from garlicsmtp.config import Config
from garlicsmtp.logger import get_logger

print_version()

cfg = Config()

logger = get_logger(cfg)

logger.info("Configuration loaded.")
logger.info("Backend: %s", cfg.get("transport", "backend"))
logger.info("SOCKS: %s:%s",
            cfg.get("tor", "host"),
            cfg.get("tor", "port"))

print()
print("GarlicSMTP initialization completed.")
